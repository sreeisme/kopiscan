# --- Supabase (Project Settings → API). Region: ap-southeast-1 (Singapore)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose, never commit. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- App
# Public base URL. Printed into every QR code, so set it to the final domain before printing table cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Signs diner table-session cookies. 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# WhatsApp Business number, digits with country code (e.g. 6591234567). Optional.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Demo request form (home page). Requests are always saved to demo_requests; email needs a Resend API key.
RESEND_API_KEY=
# Must be on a domain verified in Resend (onboarding@resend.dev only delivers to your own Resend account email).
RESEND_FROM=Kopiscan <no-reply@YOUR-DOMAIN>
DEMO_REQUEST_TO=vaka.sreekethav@gmail.com

# --- Scripts only (scripts/*.ts)
# Postgres connection string for running migrations (Project Settings → Database → Connection string, "Session pooler")
SUPABASE_DB_URL=
